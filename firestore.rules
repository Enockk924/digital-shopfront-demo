rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "hpxtcVxemAZKdqvOQ09sCJenU3m1";
    }

    function isPartner() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "partner"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /users/{userId} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isOwner();
    }

    match /projects/{projectId} {
      allow read: if isOwner()
        || (isPartner()
          && resource.data.assignedPartnerUid == request.auth.uid);

      allow create, delete: if isOwner();

      allow update: if isOwner()
        || (isPartner()
          && resource.data.assignedPartnerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["stage", "progressNotes", "qcStatus", "updatedAt"])
          && request.resource.data.stage in [
            "Work in progress",
            "Quality check",
            "Delivered"
          ]
          && request.resource.data.progressNotes is string
          && request.resource.data.qcStatus in [
            "Not checked",
            "In progress",
            "Passed",
            "Needs changes"
          ]);
    }

    // No other collections are accessible unless explicitly added here.
  }
}